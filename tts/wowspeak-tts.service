[Unit]
Description=WowSpeak TTS (Piper)
After=network.target

[Service]
Type=simple
Environment=PIPER_BIN=/opt/piper/venv/bin/piper
Environment=PIPER_VOICES=/opt/piper/voices
Environment=SUPABASE_URL=https://vtcxghsqymwkyiogpndf.supabase.co
Environment=SUPABASE_ANON_KEY=ВСТАВИТЬ_ANON_КЛЮЧ
Environment=TTS_PORT=8088
ExecStart=/usr/bin/python3 /opt/piper/tts_server.py
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
